TELEGRAM_BOT_TOKEN=0000000000:replace-with-botfather-token
TELEGRAM_MODE=polling
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_MAX_BYTES=1000000
PORT=8080

MAX_CHAT_ID=123456789
MAX_MCP_DIRECTORY=/absolute/path/to/max-mcp
MAX_MCP_COMMAND=uv

SQLITE_PATH=data/bridge.sqlite3
POLL_TIMEOUT_SECONDS=30
DELIVERY_TICK_SECONDS=1.0
DELIVERY_TIMEOUT_SECONDS=30.0
RETRY_BASE_SECONDS=5.0
RETRY_MAX_SECONDS=300.0
AMBIGUOUS_RECONCILE_DELAY_SECONDS=30.0
AMBIGUOUS_RESEND_AFTER_SECONDS=600.0
